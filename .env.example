# Local PostgreSQL. The host URL is used by local tools; Compose gives the API
# an equivalent URL whose host is the `db` service.
POSTGRES_DB=taskapp
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=taskapp
POSTGRES_PORT=5432
DATABASE_URL=postgres://taskapp:taskapp@localhost:5432/taskapp?sslmode=disable

# Kafka-compatible durable collaboration log and Redis ephemeral fan-out.
REDPANDA_PORT=19092
REDPANDA_BROKERS=localhost:19092
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
COMPACTION_THRESHOLD=500
COMPACTION_INTERVAL_MS=5000

# MinIO is the local S3-compatible attachment store. In production, omit
# S3_ENDPOINT and let the AWS SDK use S3 plus its normal IAM credential chain.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=happy-task-attachments
S3_CREATE_BUCKET=true

# Public service ports and browser-visible API origin.
WEB_PORT=3000
API_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DATA_SOURCE=api
# Optional: expose the transport badge in the workspace header while debugging.
NEXT_PUBLIC_DEBUG_UI=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The deterministic local identity seeded by `make seed-demo`.
DEFAULT_ACTOR_ID=00000000-0000-7000-8000-000000000001
# Keep false only for a deliberately unauthenticated local demo. Production and
# normal Compose runs should keep the signed session boundary enabled.
ALLOW_DEMO_ACTOR_OVERRIDE=false
# Set true when the API is served over HTTPS.
AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=false
LOG_LEVEL=info

# Scale/load defaults can be overridden per command.
TASK_COUNT=10000
COMMENT_COUNT=12000
LOAD_PROJECT_ID=02000000-0000-7000-8000-000000000001
