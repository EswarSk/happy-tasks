# Copy to env and fill in, then: set -a; . deploy/cloudrun/env; set +a; ./deploy/cloudrun/deploy.sh

# GCP project/region hosting the Cloud Run services, worker pools, and Artifact Registry repo.
GCP_PROJECT=
GCP_REGION=us-central1

# Cloud SQL for PostgreSQL, created by deploy.sh if it doesn't already exist and
# reached over its Unix-socket connector (no VPC connector needed). This is a
# self-managed schema/instance you administer (not a BaaS like Supabase) — GCP
# only handles the underlying VM, storage, and patching.
CLOUDSQL_INSTANCE=happy-task-management-db
# db-g1-small is the cheapest tier with usable throughput; db-f1-micro is cheaper
# still but shared-core and easy to bottleneck under the load test.
CLOUDSQL_TIER=db-g1-small
CLOUDSQL_DB_NAME=taskapp
CLOUDSQL_DB_USER=taskapp
CLOUDSQL_DB_PASSWORD=

# Upstash Redis (serverless, pay-per-request) connection string, e.g.
# rediss://default:pass@xxxx.upstash.io:6379
REDIS_URL=

# Redpanda Serverless cluster: comma-separated bootstrap brokers plus SASL/SCRAM
# credentials. The app dials plaintext/unauthenticated when KAFKA_SASL_USERNAME is
# empty (matches local Compose); set both to switch to SASL_SSL for a managed broker.
REDPANDA_BROKERS=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Task attachments live in a Cloud Storage bucket. deploy.sh creates the bucket and
# a dedicated api service account, and grants it bucket access — the app talks to
# GCS natively via that identity (internal/platform/objectstorage.Open routes to
# the GCS backend whenever AWS_ACCESS_KEY_ID isn't set), no keys of any kind. Leave
# blank to default to "$GCP_PROJECT-attachments".
S3_BUCKET=

# Comma-separated browser origins allowed to call the API. deploy.sh fills in the
# deployed web URL automatically after the first run; override to add a custom domain.
CORS_ALLOWED_ORIGINS=
